# ─── SERVER ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ─── DATABASE (MySQL) ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=illstar_db
DB_USER=root
DB_PASSWORD=rootpss
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars_change_this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_also_change_this
JWT_REFRESH_EXPIRES_IN=30d

# ─── EMAIL (Nodemailer) ───────────────────────────────────────
# Option A — Gmail (enable "App Passwords" in your Google account)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="ILLSTAR Studios <your_gmail@gmail.com>"

# ─── CLOUDINARY (optional — for cloud image storage) ─────────
# Leave blank to use local disk storage instead
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── SECURITY ─────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── ADMIN SEED (used only by npm run seed) ───────────────────
ADMIN_EMAIL=admin@illstar.com
ADMIN_PASSWORD=Admin@2026!
ADMIN_NAME=ILLSTAR Admin
